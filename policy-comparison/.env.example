# ============================================================
# 政策对比 MCP Server — 环境变量示例
# 复制为 .env 后按需修改；应用内运行时 Key 由宿主自动注入，无需在此填写
# ============================================================

# DashScope API Key（留空则自动降级为规则对比，输出不含 aiExplanation）
DASHSCOPE_API_KEY=

# LLM 模型（默认 qwen3.7-plus）
# POLICY_COMPARE_LLM_MODEL=qwen3.7-plus

# LLM 超时秒数（前端仅轮询 30s，超时即降级规则对比）
# POLICY_COMPARE_LLM_TIMEOUT=20

# 强制禁用 LLM（1/true 时直走规则对比，便于离线调试）
# POLICY_COMPARE_DISABLE_LLM=0

# 规则库目录（默认指向 ../policy-search/knowledge_base）
# KNOWLEDGE_BASE_DIR=

# 上传文件按文件名搜索的目录（分号分隔，默认桌面/下载/文档）
# POLICY_COMPARE_SEARCH_DIRS=C:/Users/me/Desktop;C:/Users/me/Downloads;C:/Users/me/Documents

# 搜索目录遍历限制
# POLICY_COMPARE_SEARCH_MAX_DEPTH=3
# POLICY_COMPARE_SEARCH_MAX_FILES=3000

# 名称模糊匹配最低相似度（0~1）
# POLICY_COMPARE_MATCH_THRESHOLD=0.6

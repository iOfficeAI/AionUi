# Matplotlib Style — Vietnamese Stock Market Analyst
# Powered by AI Analyst Lab | aianalystlab.ai
# SWD (Storytelling With Data) patterns: decluttered, focused, branded

# Figure
figure.facecolor: F7F6F2
figure.edgecolor: F7F6F2
figure.figsize: 10, 6
figure.dpi: 150

# Font
font.family: sans-serif
font.sans-serif: Inter, -apple-system, BlinkMacSystemFont, Segoe UI, Helvetica, Arial, sans-serif
font.size: 10

# Axes - SWD declutter
axes.facecolor: F7F6F2
axes.edgecolor: E5E7EB
axes.linewidth: 0.5
axes.titlesize: 14
axes.titleweight: bold
axes.titlepad: 15
axes.titlecolor: 1a1a2e
axes.labelsize: 10
axes.labelcolor: 4B5563
axes.labelpad: 8
axes.spines.top: False
axes.spines.right: False
axes.prop_cycle: cycler('color', ['D97706', 'DC2626', '059669', '6B7280', '4cc9f0', '7209b7'])

# Grid - Subtle y-only
axes.grid: True
axes.grid.axis: y
grid.color: E5E7EB
grid.linewidth: 0.5
grid.alpha: 0.5

# Ticks
xtick.color: 4B5563
xtick.labelsize: 9
xtick.major.size: 0
xtick.minor.size: 0
ytick.color: 4B5563
ytick.labelsize: 9
ytick.major.size: 0
ytick.minor.size: 0

# Legend - Clean
legend.frameon: False
legend.fontsize: 9
legend.loc: best

# Lines
lines.linewidth: 2
lines.markersize: 6

# Bars
patch.linewidth: 0

# Savefig
savefig.dpi: 150
savefig.bbox: tight
savefig.facecolor: F7F6F2
savefig.edgecolor: F7F6F2
savefig.pad_inches: 0.2

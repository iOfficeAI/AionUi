# DashScope API Key（必填）
# 获取地址：https://dashscope.console.aliyun.com/
DASHSCOPE_API_KEY=your_api_key_here

# Embedding 模型
EMBEDDING_MODEL=text-embedding-v4

# ChromaDB 数据持久化目录
CHROMA_PERSIST_DIR=./chroma_data

# 文档分块参数（字符数）
CHUNK_SIZE=500
CHUNK_OVERLAP=50

# 检索参数：默认返回条数 / 相似度下限（低于该值的结果不返回）
TOP_K=3
SCORE_THRESHOLD=0.3

# Embedding 批大小与失败重试次数
EMBED_BATCH_SIZE=10
EMBED_MAX_RETRIES=3

# 日志级别（DEBUG/INFO/WARNING/ERROR），日志输出到 stderr
LOG_LEVEL=INFO
